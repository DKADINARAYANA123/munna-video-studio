# Copy to .env.local. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/autoclip?sslmode=require"
APP_BASE_URL="http://localhost:3000"
# Optional LLM endpoint. Keep API keys server-side only.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Optional speech-to-text provider key (example OpenAI-compatible endpoint)
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_BASE_URL="https://api.openai.com/v1"
# Optional object storage / worker configuration
MEDIA_BUCKET=""
MEDIA_PUBLIC_BASE_URL=""
WORKER_SHARED_SECRET=""
# Auth provider values should be added when real authentication is configured.
